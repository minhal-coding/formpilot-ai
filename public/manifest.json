{
  "manifest_version": 3,
  "name": "FormPilot AI",
  "version": "1.0.0",
  "description": "Review sourced answers from your local profile, then fill only the fields you choose. Never submits.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "optional_host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Open FormPilot"},
  "side_panel": {"default_path": "panel.html"},
  "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Open FormPilot"}},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:3210"}
}
